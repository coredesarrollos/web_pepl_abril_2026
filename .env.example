# PEpL Web — env vars
# Copiar a .env.local y completar valores. NUNCA commitear .env.local.
# Valores reales viven en Vercel (Production/Preview/Development separados).

# === App ===
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_LOCALE="es"

# === Microsoft Clarity ===
NEXT_PUBLIC_CLARITY_ID=""

# === Sanity CMS ===
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2026-04-29"
SANITY_API_READ_TOKEN=""
SANITY_API_WRITE_TOKEN=""
SANITY_REVALIDATE_SECRET=""

# === Email (Resend) ===
RESEND_API_KEY=""
RESEND_FROM="PEpL <hello@pepl.app>"
LEAD_NOTIFY_TO="pepl.marketplace@gmail.com"

# === Rate limiting (Upstash) ===
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# === Cloudflare Turnstile ===
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# === Sentry ===
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# === Pitch protection ===
# Token simple en cookie `pepl_pitch` para gatear /theme-lab, /studio y /pitch.
# Generar con: openssl rand -hex 32
PITCH_ACCESS_TOKEN=""

# === Social APIs (Fase 4 — opcional) ===
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_BUSINESS_ID=""
LINKEDIN_ACCESS_TOKEN=""
LINKEDIN_PAGE_ID=""
TIKTOK_ACCESS_TOKEN=""
YOUTUBE_API_KEY=""

# === Cron / webhooks ===
CRON_SECRET=""

# === Backups (env-backup script) ===
# La key age NO va aquí — vive solo en password manager + GH Actions secret.
AGE_RECIPIENT="age1..."
